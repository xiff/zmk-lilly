#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    combos {
        compatible = "zmk,combos";

        // Combo pour accéder au layer Bluetooth
        combo_bt_layer {
            timeout-ms = <50>;
            key-positions = <40 41>; // SPACE + ENTER ensemble
            bindings = <&mo 2>;
        };

        // Combo pour déverrouiller ZMK Studio
        // Appuyez sur les deux touches de pouce extérieures simultanément
        combo_studio_unlock {
            timeout-ms = <50>;
            key-positions = <39 40>; // LWR (gauche) + SPACE
            bindings = <&studio_unlock>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
// ------------------------------------------------------------------------------------------------------------
// |  ESC  |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |   -   |
// |  TAB  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   |   ü   |
// | SHIFT |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ö   |   ä   |
// | CTRL  |  Z  |  X  |  C   |  V   |  B   |                   |  N   |  M    | ,     | .    | /     | $     |
//                     | LWR  | GUI  | RCTRL| FSLH |       | RALT | SPACE| RET   | RSHFT |
            bindings = <
&kp ESC   &kp N1 &kp N2    &kp N3    &kp N4   &kp N5                     &kp N6    &kp N7    &kp N8    &kp N9    &kp N0    &kp MINUS
&kp TAB   &kp Q  &kp W     &kp E     &kp R    &kp T                      &kp Y     &kp U     &kp I     &kp O     &kp P     &kp LBKT
&kp LSHFT &kp A  &kp S     &kp D     &kp F    &kp G                      &kp H     &kp J     &kp K     &kp L     &kp SEMI  &kp SQT
&kp LCTRL &kp Z  &kp X     &kp C     &kp V    &kp B                      &kp N     &kp M     &kp COMMA &kp DOT   &kp FSLH  &kp DLLR
                           &mo 1     &kp LGUI &kp RCTRL &kp FSLH         &kp RALT  &kp SPACE &kp RET   &kp RSHFT
            >;
        };

        lower_layer {
// ------------------------------------------------------------------------------------------------------------
// | NUMLOCK| F1| F2| F3 | F4 | F5 |                  |  F6  |  F7   |  F8   |  F9  |  F10  |  F11  |
// |   `    | KP 7| KP 8| KP 9 | KP - | KP + |                  | PGUP |  UP   | PGDN  | END  |  DEL  |  F12  |
// | /  | KP 4| KP 5| KP 6 |KP ENT| KP = |                  | LEFT | DOWN  | RIGHT | HOME |   [   |   ]   |
// | KP 0  | KP 1| KP 2| KP 3 |TRANS |TRANS |                  | TRANS| TRANS | TRANS | TRANS | TRANS | TRANS |
//                      | TRANS| TRANS| TRANS| TRANS|                  | TRANS| TRANS | TRANS | TRANS|
            bindings = <
&kp KP_NUM &kp F1 &kp F2 &kp F3 &kp F4 &kp F5              &kp F6    &kp F7   &kp F8     &kp F9    &kp F10  &kp F11
&kp GRAVE  &kp KP_N7 &kp KP_N8 &kp KP_N9 &kp KP_MINUS  &kp KP_PLUS                  &kp PG_UP &kp UP   &kp PG_DN  &kp END   &kp DEL  &kp F12
&kp KP_DIVIDE     &kp KP_N4 &kp KP_N5 &kp KP_N6 &kp KP_ENTER  &kp KP_EQUAL                 &kp LEFT  &kp DOWN &kp RIGHT  &kp HOME  &kp LBKT &kp RBKT
&kp KP_N0     &kp KP_N1 &kp KP_N2 &kp KP_N3 &trans    &trans                       &trans    &trans   &trans     &trans    &trans   &trans
                                &trans     &trans      &trans    &trans             &trans    &trans   &trans     &trans
            >;
        };

        bluetooth_layer {
// ------------------------------------------------------------------------------------------------------------
// | BTCLR | BT1 | BT2 |  BT3 |  BT4 |  BT5 |                   | TRANS | TRANS | TRANS | TRANS | TRANS | TRANS |
// | TRANS | TRANS | TRANS | TRANS | TRANS | TRANS |            | TRANS | TRANS | TRANS | TRANS | TRANS | TRANS |
// | TRANS | TRANS | TRANS | TRANS | TRANS | TRANS |            | TRANS | TRANS | TRANS | TRANS | TRANS | TRANS |
// | TRANS | TRANS | TRANS | TRANS | TRANS | TRANS |            | TRANS | TRANS | TRANS | TRANS | TRANS | TRANS |
//                        | TRANS | TRANS | TRANS | TRANS |          | TRANS | TRANS | TRANS | TRANS |
            bindings = <
&bt BT_CLR &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4             &trans &trans &trans &trans &trans &trans
&trans     &trans       &trans       &trans       &trans       &trans                   &trans &trans &trans &trans &trans &trans
&trans     &trans       &trans       &trans       &trans       &trans                   &trans &trans &trans &trans &trans &trans
&trans     &trans       &trans       &trans       &trans       &trans                   &trans &trans &trans &trans &trans &trans
                                     &trans       &trans       &trans  &trans           &trans &trans &trans &trans
            >;
        };
    };
};