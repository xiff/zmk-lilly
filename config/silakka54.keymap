#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    combos {
        compatible = "zmk,combos";

        // Combo pour acceder au layer Bluetooth (third)
        combo_bt_layer {
            timeout-ms = <50>;
            key-positions = <40 41>; // SPACE + ENTER ensemble
            bindings = <&mo 2>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
// ------------------------------------------------------------------------------------------------------------
// |  ESC  |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |  NUHS |
// |  TAB  |  Q  |  W  |  E   |  R   |  T   |                   |  Z   |  U    |  I    |  O   |   P   |   '   |
// | SHIFT |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   [   |
// | CTRL  |  Y |  X  |  C   |  V   |  B   |                   |  N   |  M    |  ,    |  .   |   /   |  GUI  |
//                     | ALT  |  .   | SPACE|                   | RET  | BKSP  | MO(1) |
            bindings = <
&kp ESC   &kp N1 &kp N2    &kp N3    &kp N4   &kp N5                     &kp N6    &kp N7    &kp N8    &kp N9    &kp N0    &kp NUHS
&kp TAB   &kp Q  &kp W     &kp E     &kp R    &kp T                      &kp Z     &kp U     &kp I     &kp O     &kp P     &kp SQT
&kp LSHFT &kp A  &kp S     &kp D     &kp F    &kp G                      &kp H     &kp J     &kp K     &kp L     &kp SEMI  &kp LBKT
&kp LCTRL &kp Y  &kp X     &kp C     &kp V    &kp B                      &kp N     &kp M     &kp COMMA &kp DOT   &kp FSLH  &kp RGUI
                           &kp LALT  &kp SPACE &mo 1                  &kp RET   &mo 2     &kp BSPC
            >;
        };

        num {
// ------------------------------------------------------------------------------------------------------------
// |  NUM  |  F1  |  F2  |  F3  |  F4  |  F5  |                   |  F6  |  F7   |  F8   |  F9   |  F10  |  F11  |
// |   `   |      |  -   | 7 HM | 8 UP | 9 PU |                   | PGUP | HOME  |   UP  |  END  |  END  |  F12  |
// |   /   |      |      |  4 L | 5 DN | 6 R  |                   | PGDN |  LEFT |  DOWN | RIGHT | HOME  | VOLUP |
// |  GUI  |      | 0 IN | 1 EN | 2 DN | 3 PD |                   |  4   |   {   |   }   |  LEFT | RIGHT | VOLDN |
//                     | TRANS| TRANS| ENT  |                   | TRANS| TRANS | TRANS |
            bindings = <
&kp KP_NUM &kp F1    &kp F2    &kp F3     &kp F4      &kp F5                    &kp F6    &kp F7    &kp F8    &kp F9    &kp F10   &kp F11
&kp GRAVE  &none     &kp MINUS &kp KP_N7  &kp KP_N8   &kp KP_N9                 &kp PG_UP &kp HOME  &kp UP    &kp END   &kp END   &kp F12
&kp FSLH   &none     &none     &kp KP_N4  &kp KP_N5   &kp KP_N6                 &kp PG_DN &kp LEFT  &kp DOWN  &kp RIGHT &kp HOME  &kp K_VOL_UP
&kp LGUI   &none     &kp KP_N0 &kp KP_N1  &kp KP_N2   &kp KP_N3                 &kp N4    &kp LBRC  &kp RBRC  &kp LEFT  &kp RIGHT &kp K_VOL_DN
                               &trans     &trans      &kp RET                   &trans    &trans    &trans
            >;
        };

        third {
// ------------------------------------------------------------------------------------------------------------
// | BTCLR | BT1 | BT2 |  BT3 |  BT4 |  BT5 |                   | PREV | NEXT  | PLAY  | VOL_DN| VOL_UP|       |
// |       |     |     |      |      |      |                   |      |       |       |       |       |       |
// |       |     |     |      |      |      |                   |      |       |   {   |   }   |   '   |       |
// |       |     |     |      |      |      |                   |      |       |  NUHS | NUBS  |       |       |
//                     | TRANS| TRANS| TRANS|                   | TRANS| TRANS | TRANS |
            bindings = <
&bt BT_CLR &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4             &kp C_PREV &kp C_NEXT &kp C_PP &kp C_VOL_DN &kp C_VOL_UP &none
&none      &none        &none        &none        &none        &none                    &none      &none      &none    &none        &none        &none
&none      &none        &none        &none        &none        &none                    &none      &none      &kp LBRC &kp RBRC     &kp SQT      &none
&none      &none        &none        &none        &none        &none                    &none      &none      &kp NUHS &kp NUBS     &none        &none
                                     &trans       &trans       &trans                   &trans     &trans     &trans
            >;
        };
    };
};

